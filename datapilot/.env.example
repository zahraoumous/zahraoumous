# Local development only. Copy to .env; never use these credentials in production.
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=local-datapilot-only
POSTGRES_DB=datapilot
MINIO_ROOT_USER=datapilot-local
MINIO_ROOT_PASSWORD=local-minio-only-change-me
# Optional: a separate long random secret for encrypting per-account AI keys.
# Set this before first saving AI keys. Keep it stable and back it up securely.
# If empty, encryption derives from MINIO_ROOT_PASSWORD for compatible updates.
# Changing the active secret makes saved keys unreadable; re-enter them in AI settings.
DATAPILOT_AI_KEY_ENCRYPTION_SECRET=
